# ==============================================================================
# AtlasCloud IaaS - Variáveis de Ambiente de Exemplo (.env.example)
# Nota: Todas as chaves e credenciais são 100% fictícias para fins acadêmicos
# ==============================================================================

# Porta pública única do API Gateway
GATEWAY_PORT=8080
UPSTREAM_TIMEOUT_MS=2000

# Portas internas (escutam exclusivamente em 127.0.0.1 / rede interna)
COMPUTE_PORT=8081
SECURITY_PORT=8082
BILLING_PORT=8083
GRAPHQL_PORT=8084

# Endereços internos dos serviços
COMPUTE_SERVICE_URL=http://127.0.0.1:8081
SECURITY_SERVICE_URL=http://127.0.0.1:8082
BILLING_SERVICE_URL=http://127.0.0.1:8083
GRAPHQL_SERVICE_URL=http://127.0.0.1:8084

# Broker RabbitMQ 4 (credenciais padrão de desenvolvimento local)
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/

# Chaves de API fictícias cadastradas no Gateway (para testes com curl)
API_KEY_CONSOLE_WEB=console-web
API_KEY_CLI_TERRAFORM=cli-terraform
API_KEY_PARCEIRO_AUDITORIA=parceiro-auditoria
